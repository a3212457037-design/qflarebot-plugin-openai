{
  "name": "openai",
  "version": "0.1.0",
  "apiVersion": 4,
  "permissions": [
    "net",
    "kv",
    "db"
  ],
  "depends": {},
  "conflicts": [],
  "commands": [
    {
      "name": "ai",
      "description": "向 OpenAI 提问",
      "usage": "/ai <问题>",
      "scenes": [
        "c2c",
        "group"
      ]
    },
    {
      "name": "search",
      "description": "联网搜索并由 AI 整理回答",
      "usage": "/search <关键词>",
      "scenes": [
        "c2c",
        "group"
      ]
    },
    {
      "name": "model",
      "description": "查看或切换当前会话模型",
      "usage": "/model [序号|模型ID|default]",
      "scenes": [
        "c2c",
        "group"
      ]
    },
    {
      "name": "more",
      "description": "领取长回答剩余正文",
      "usage": "/more",
      "scenes": [
        "c2c",
        "group"
      ]
    },
    {
      "name": "reset",
      "description": "清除当前对话历史",
      "usage": "/reset",
      "scenes": [
        "c2c",
        "group"
      ]
    }
  ],
  "regex": [
    {
      "pattern": "\\S",
      "scenes": [
        "c2c",
        "group"
      ],
      "priority": -100,
      "block": false
    }
  ],
  "events": [],
  "buttons": [],
  "cron": [
    {
      "name": "background",
      "cron": "* * * * *"
    }
  ],
  "routes": [
    {
      "method": "GET",
      "path": "/ui/",
      "auth": "admin"
    },
    {
      "method": "GET",
      "path": "/api/status",
      "auth": "admin"
    },
    {
      "method": "POST",
      "path": "/callback",
      "auth": "public"
    }
  ],
  "hasMiddleware": false,
  "services": [],
  "durableObjects": [],
  "displayName": "OpenAI 文本问答",
  "description": "通过 OpenAI Responses API 聊天，支持原生搜索、上下文与后台自动回复",
  "configSchema": {
    "type": "object",
    "properties": {
      "apiKey": {
        "type": "string",
        "title": "OpenAI API Key",
        "writeOnly": true,
        "maxLength": 4096,
        "default": "",
        "description": "仅填写 OpenAI 官方 API Key，保存后不回显。独立于 Gemini；不要把密钥发到 QQ 或聊天中。"
      },
      "model": {
        "type": "string",
        "title": "默认聊天模型",
        "enum": [
          "gpt-6-luna",
          "gpt-6.1-sol",
          "gpt-6-astra",
          "gpt-6.1-terra"
        ],
        "default": "gpt-6.1-terra",
        "description": "聊天用 /model 切换当前会话，/model default 跟随后台默认。权限及额度以 OpenAI 项目为准，不自动换模型。"
      },
      "executionMode": {
        "type": "string",
        "title": "推理执行模式",
        "enum": [
          "responses",
          "background"
        ],
        "default": "background",
        "description": "默认后台推理，由现有每分钟 Cron 自动回复，支持超过 30 秒的推理。responses 为同步模式，最多等待 27 秒。后台需要现有 D1、KV 和每分钟 Cron。"
      },
      "backgroundDelivery": {
        "type": "string",
        "title": "后台结果通知方式",
        "enum": [
          "cron",
          "webhook"
        ],
        "default": "cron",
        "description": "cron 保留原有轮询；webhook 使用签名回调触发取结果，Cron 仅恢复已收到的通知，不轮询无通知的远端任务。切换前请配置 OpenAI 项目 Webhook。"
      },
      "webhookSecret": {
        "type": "string",
        "title": "OpenAI Webhook 签名密钥",
        "writeOnly": true,
        "default": "",
        "maxLength": 256,
        "description": "填写 OpenAI Webhook 提供的 whsec_ 签名密钥，区别于 API Key。回调地址为本站 /p/openai/callback。保存后不回显。"
      },
      "reasoningEffort": {
        "type": "string",
        "title": "推理档位",
        "enum": [
          "low",
          "medium",
          "high",
          "xhigh",
          "max"
        ],
        "default": "high",
        "description": "四个内置模型均支持 high 与 max，默认 Terra + high。高推理可能增加延迟和 Token 消耗，建议保持后台模式。"
      },
      "enableWebSearch": {
        "type": "boolean",
        "title": "启用 OpenAI 原生联网搜索",
        "default": true,
        "description": "由模型按需调用官方 web_search；/search 强制搜索。不使用 Tavily，也不需要其他搜索 Key。搜索调用按 OpenAI 项目计费，每轮最多 3 次内置工具调用，非账户费用封顶。"
      },
      "maxInputChars": {
        "type": "integer",
        "title": "问题字符上限",
        "default": 1000,
        "minimum": 1,
        "maximum": 1000
      },
      "maxOutputTokens": {
        "type": "integer",
        "title": "生成 Token 上限",
        "default": 128000,
        "minimum": 64,
        "maximum": 128000,
        "description": "四个内置模型的官方最大值 128000，包含可见输出及推理 Token。只是允许的上限，普通闲聊保持简洁。"
      },
      "timeoutMs": {
        "type": "integer",
        "title": "HTTP 超时（毫秒）",
        "default": 27000,
        "minimum": 1000,
        "maximum": 27000,
        "description": "同步模式最多 27 秒；后台仅对每次提交/查询 HTTP 最多等待 8 秒，不限制远端推理总时长。QQ 回复窗口仍有效。"
      },
      "ignoredCommandPrefixes": {
        "type": "array",
        "title": "跳过的命令前缀",
        "default": [
          "/"
        ],
        "maxItems": 16,
        "items": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32
        },
        "description": "普通聊天跳过这些前缀开头的命令，/ 始终跳过。SDK 无全局前缀读取接口，自定义前缀需在此同步填写。"
      }
    },
    "required": [
      "apiKey",
      "maxInputChars",
      "maxOutputTokens",
      "timeoutMs"
    ]
  },
  "defaultConfig": {
    "apiKey": "",
    "model": "gpt-6.1-terra",
    "executionMode": "background",
    "reasoningEffort": "high",
    "enableWebSearch": true,
    "maxInputChars": 1000,
    "maxOutputTokens": 128000,
    "timeoutMs": 27000,
    "ignoredCommandPrefixes": [
      "/"
    ],
    "backgroundDelivery": "cron",
    "webhookSecret": ""
  },
  "ui": {
    "path": "/ui/",
    "title": "OpenAI 后台任务",
    "icon": "Clock"
  }
}
